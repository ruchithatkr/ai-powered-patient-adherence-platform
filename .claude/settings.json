    "PreToolUse": [{"matcher": "mcp__.*", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/hooks/pre_tool_use.py", "timeout": 15}]}],
    "PostToolUse": [{"matcher": "mcp__.*", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/hooks/post_tool_use.py", "timeout": 15}]}],
    "PostToolUseFailure": [{"matcher": "mcp__.*", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/hooks/post_tool_use_failure.py", "timeout": 15}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/hooks/subagent_events.py", "timeout": 15}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/hooks/subagent_events.py", "timeout": 15}]}],
