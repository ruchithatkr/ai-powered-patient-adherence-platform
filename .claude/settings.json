{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": ".venv/bin/python hooks/session_start.py"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": ".venv/bin/python hooks/user_prompt_submit.py"}]}],
    "PreToolUse": [{"matcher": "mcp__.*", "hooks": [{"type": "command", "command": ".venv/bin/python hooks/pre_tool_use.py"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": ".venv/bin/python hooks/stop.py"}]}]
  }
}
